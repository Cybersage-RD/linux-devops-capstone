[Unit]
Description=Rohan Linux Capstone Web Service
After=network.target

[Service]
Type=simple
User=rohand
Group=rohand
WorkingDirectory=/home/rohand/linux-capstone
EnvironmentFile=/home/rohand/linux-capstone/config/app.env
ExecStart=/usr/bin/python3 -u -m http.server ${APP_PORT} --bind ${APP_BIND} --directory /home/rohand/linux-capstone/app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
